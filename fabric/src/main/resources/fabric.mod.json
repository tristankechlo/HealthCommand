{
    "schemaVersion": 1,
    "id": "healthcommand",
    "version": "${version}",
    "name": "healthcommand",
    "description": "adds a simple /health command",
    "authors": [
        "Buecher_wurm"
    ],
    "contact": {
        "sources": "https://github.com/tristankechlo/HealthCommand",
        "issues": "https://github.com/tristankechlo/HealthCommand/issues"
    },
    "license": "CC BY-NC-ND 4.0",
    "icon": "logo.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.tristankechlo.healthcommand.FabricHealthCommand"
        ]
    },
    "mixins": [
        "healthcommand.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_min}",
        "fabric-api": "*",
        "minecraft": ">=${fabric_range_min_inclusive} <${fabric_range_max_exclusive}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/bhUaWhq",
                "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/health-command",
                "modmenu.modrinth": "https://modrinth.com/mod/health-command"
            }
        }
    }
}